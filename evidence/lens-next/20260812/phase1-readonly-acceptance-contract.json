  "acceptanceCases": [
    {
      "id": "p1-project-selection",
      "expected": "Only authenticated authorized BIMLog projects are selectable; changing project clears prior rows and requests that exact project"
    },
    {
      "id": "p1-live-read",
      "expected": "Issue rows render from the real production Lens query/component contract with loading, useful empty, denied and error states"
    },
    {
      "id": "p1-filter-details",
      "expected": "Search and status/trade/floor/priority filters are deterministic; opening details does not mutate server or native state"
    },
    {
      "id": "p1-refresh-idempotency",
      "expected": "Two identical refresh responses produce identical UI state and zero writes/duplicates"
    },
    {
      "id": "p1-unique-jump",
      "expected": "One candidate satisfying every supplied immutable criterion opens exactly that candidate without changing visual bytes"
    },
    {
      "id": "p1-missing-jump",
      "expected": "Zero immutable matches blocks with an explicit not-found result; no label/path/active-view fallback"
    },
    {
      "id": "p1-ambiguous-jump",
      "expected": "Two or more matches block with an explicit ambiguity result; no navigation, creation or mutation"
    },
    {
      "id": "p1-offline",
      "expected": "Offline/API/bridge failure is visible and retry remains read-only and duplicate-free"
    },
    {
      "id": "p1-legacy-nonregression",
      "expected": "Legacy source hashes, plugin IDs, state paths, installation definitions and fixture results are unchanged after Next tests"
    },
    {
      "id": "p1-no-savedviewpoint-processing",
      "expected": "Starting, selecting a project, refreshing, filtering and closing Next create/move/rename/delete zero SavedViewpoints and write zero Legacy metadata"
    }
  ],
