modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "db-dev-sync"

[[workflows.workflow]]
name = "db-dev-sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "BIMLOG_SCHEMA_TARGET=development pnpm --filter @workspace/db run sync-development"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.shared]
BIMLOG_URL = "https://bimlog.app"
APP_URL = "https://bimlog.app"
BIMLOG_FEEDBACK_STORAGE_BACKEND = "replit-app-storage"
BIMLOG_FEEDBACK_APP_STORAGE_BUCKET_ID = "replit-objstore-8239dcf7-d5e0-4821-b81a-15ba62a1ffd7"
BIMLOG_FEEDBACK_STORAGE_BACKEND_ID = "bimlog-feedback-replit"
BIMLOG_FEEDBACK_STORAGE_MAX_READ_BYTES = "20971520"
BIMLOG_FEEDBACK_SCANNER = "clamav-cli"
BIMLOG_FEEDBACK_SCANNER_EXECUTABLE = "/home/runner/workspace/artifacts/api-server/scripts/feedback-clamav-replit.sh"
BIMLOG_FEEDBACK_SCANNER_EXECUTABLE_SHA256 = "294b420762f6dff735f482b908da5037c49e8cbb0e99c3d10e97d65f1084b0f6"
BIMLOG_FEEDBACK_SCANNER_EXECUTABLE_VERSION = "ClamAV 1.4.3"
BIMLOG_FEEDBACK_SCANNER_TIMEOUT_MS = "120000"
BIMLOG_FEEDBACK_SCANNER_VERSION_TIMEOUT_MS = "120000"

[nix]
channel = "stable-25_05"
packages = ["libreoffice", "clamav"]

[objectStorage]
defaultBucketID = "replit-objstore-8239dcf7-d5e0-4821-b81a-15ba62a1ffd7"
