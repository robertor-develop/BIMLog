{
  "name": "workspace",
  "version": "0.0.0",
  "engines": {
    "pnpm": ">=10.26.1 <12"
  },
  "bimlogToolchain": {
    "localPnpm": "11.17.0",
    "replitPnpmRange": ">=10.26.1 <12"
  },
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "audit:platform": "node scripts/platform-audit.mjs",
    "audit:production": "pnpm audit --prod --audit-level low",
    "check:dependency-provenance": "node scripts/check-dependency-provenance.mjs",
    "check:release-lineage": "node scripts/check-release-lineage.mjs",
    "test:release-lineage": "node scripts/test-release-lineage.mjs",
    "generate:release-identity": "node scripts/generate-release-identity.mjs",
    "check:release-identity": "node scripts/check-release-identity.mjs",
    "test:release-identity": "node scripts/test-release-identity.mjs",
    "check:release-receipt": "node scripts/check-release-receipt.mjs",
    "test:release-receipt": "node scripts/test-release-receipt.mjs",
    "check:checkout-readiness": "node scripts/check-checkout-readiness.mjs",
    "test:checkout-readiness": "node scripts/test-checkout-readiness.mjs",
    "test:api-build-termination": "node scripts/test-api-build-termination.mjs",
    "check:living-brief": "node scripts/check-living-brief.mjs",
    "test:release-policy": "node scripts/check-living-brief.mjs --self-test-release-policy",
    "living-brief:state": "node scripts/update-living-brief-state.mjs",
    "test:living-brief": "node scripts/test-living-brief-gate.mjs",
    "test:living-brief-architecture": "node scripts/test-living-brief-architecture.mjs",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:tracked-secret-exposure": "node scripts/check-tracked-secret-exposure.mjs",
    "test:tracked-secret-exposure": "node scripts/check-tracked-secret-exposure.mjs --self-test && node scripts/check-tracked-secret-exposure.mjs",
    "check:database-safety": "node scripts/check-database-safety.mjs",
    "test:database-safety": "node scripts/test-database-safety.mjs",
    "schema:receipt": "node scripts/database-schema-receipt.mjs",
    "test:schema-receipt": "node scripts/test-database-schema-receipt.mjs",
    "migration:preview-receipt": "node scripts/migration-preview-receipt.mjs",
    "test:migration-preview-receipt": "node scripts/test-migration-preview-receipt.mjs",
    "prepare:artifact-proof-fixture": "node scripts/prepare-artifact-proof-fixture.mjs --prepare",
    "check:artifact-proof-fixture": "node scripts/prepare-artifact-proof-fixture.mjs --check",
    "test:artifact-proof-fixture-guard": "node scripts/test-artifact-proof-fixture-guard.mjs",
    "test:artifact-proof-fixture-repeatability": "node scripts/test-artifact-proof-fixture-repeatability.mjs",
    "attest:publication-source": "node scripts/check-database-safety.mjs --attest-source",
    "gate:pre-push": "pnpm run check:dependency-provenance && pnpm run audit:production && pnpm run test:tracked-secret-exposure && pnpm run test:database-safety && pnpm run check:artifact-proof-fixture && pnpm run build && pnpm --filter @workspace/api-server run test:production-artifact",
    "build": "node scripts/check-release-identity.mjs && node scripts/check-tracked-secret-exposure.mjs && node scripts/check-database-safety.mjs && node scripts/check-mojibake.mjs && node scripts/check-living-brief.mjs && node ./node_modules/typescript/bin/tsc --build && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "adm-zip": "0.6.1"
  }
}
